generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENTE
}

enum TipoRefeicao {
  CAFE_DA_MANHA
  LANCHE_DA_MANHA
  ALMOCO
  LANCHE_DA_TARDE
  JANTA
  CEIA
}

model Usuario {
  id             String   @id @default(cuid())
  nome           String
  email          String   @unique
  senhaHash      String
  role           Role     @default(CLIENTE)
  telefone       String?
  dataNascimento DateTime?
  pesoAtual      Float?
  altura         Float?
  objetivo       String?
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  dietas          Dieta[]
  checksRefeicao  CheckRefeicao[]
  feedbacks       Feedback[]
  progressos      RegistroProgresso[]
  avaliacoes      Avaliacao[]
}

model Dieta {
  id        String   @id @default(cuid())
  titulo    String
  ativa     Boolean  @default(true)
  criadaEm  DateTime @default(now())

  clienteId String
  cliente   Usuario @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  refeicoes Refeicao[]
}

model Refeicao {
  id              String       @id @default(cuid())
  tipo            TipoRefeicao
  horarioSugerido String?

  dietaId String
  dieta   Dieta @relation(fields: [dietaId], references: [id], onDelete: Cascade)

  alimentos Alimento[]
  checks    CheckRefeicao[]
}

model Alimento {
  id         String  @id @default(cuid())
  nome       String
  quantidade String
  observacao String?

  refeicaoId String
  refeicao   Refeicao @relation(fields: [refeicaoId], references: [id], onDelete: Cascade)

  receitaId String?
  receita   Receita? @relation(fields: [receitaId], references: [id])
}

model Receita {
  id           String   @id @default(cuid())
  titulo       String
  ingredientes String[]
  modoPreparo  String[]
  tempoPreparo String?
  videoUrl     String?

  alimentos Alimento[]
}

model CheckRefeicao {
  id        String   @id @default(cuid())
  data      String   // YYYY-MM-DD
  realizada Boolean  @default(false)

  clienteId  String
  cliente    Usuario @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  refeicaoId String
  refeicao   Refeicao @relation(fields: [refeicaoId], references: [id], onDelete: Cascade)

  @@unique([clienteId, refeicaoId, data])
}

model Feedback {
  id       String   @id @default(cuid())
  data     String
  texto    String
  criadoEm DateTime @default(now())

  clienteId String
  cliente   Usuario @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

model RegistroProgresso {
  id      String   @id @default(cuid())
  data    String
  peso    Float?
  aguaMl  Int?
  criadoEm DateTime @default(now())

  clienteId String
  cliente   Usuario @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, data])
}

model Post {
  id         String   @id @default(cuid())
  titulo     String
  slug       String   @unique
  resumo     String
  conteudo   String
  imagemUrl  String?
  publicado  Boolean  @default(false)
  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

enum StatusAgendamento {
  PENDENTE
  CONFIRMADO
  CANCELADO
  REALIZADO
}

model Agendamento {
  id        String             @id @default(cuid())
  tipo      String
  data      String
  horario   String
  nome      String
  email     String
  telefone  String
  mensagem  String?
  status    StatusAgendamento  @default(PENDENTE)
  criadoEm  DateTime           @default(now())
}

model ConfigSite {
  id         String  @id @default("config")
  fotoSobre  String?
  fotoCapa   String?
  bio1       String?
  bio2       String?
  crn        String?
  especialidades String[]
  telefone   String?
  endereco   String?
  instagram  String?
  whatsapp   String?
}

model Servico {
  id        String  @id @default(cuid())
  titulo    String
  descricao String
  icone     String?
  imagemUrl String?
  ordem     Int     @default(0)
  ativo     Boolean @default(true)
}

model Plano {
  id        String   @id @default(cuid())
  nome      String
  preco     String
  periodo   String
  destaque  Boolean  @default(false)
  itens     String[]
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
}

model Avaliacao {
  id        String   @id @default(cuid())
  nota      Int      @default(5)
  texto     String
  aprovada  Boolean  @default(false)
  criadoEm  DateTime @default(now())

  clienteId String
  cliente   Usuario @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

model PerfilFoto {
  id     String @id @default(cuid())
  foto   String
  userId String @unique
}
