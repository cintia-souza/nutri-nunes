generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENTE
}

enum TipoRefeicao {
  CAFE_DA_MANHA
  LANCHE_DA_MANHA
  ALMOCO
  LANCHE_DA_TARDE
  JANTA
  CEIA
}

model Usuario {
  id             String   @id @default(cuid())
  nome           String
  email          String   @unique
  senhaHash      String
  role           Role     @default(CLIENTE)
  telefone       String?
  dataNascimento DateTime?
  pesoAtual      Float?
  altura         Float?
  objetivo       String?
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  dietas          Dieta[]
  checksRefeicao  CheckRefeicao[]
  feedbacks       Feedback[]
  progressos      RegistroProgresso[]
  avaliacoes      Avaliacao[]
  habitos         RegistroHabito[]
  avaliacoesNutricionais AvaliacaoNutricional[]
  entradasDiario  EntradaDiario[]
  formularios     Formulario[]
}

model Dieta {
  id        String   @id @default(cuid())
  titulo    String
  ativa     Boolean  @default(true)
  criadaEm  DateTime @default(now())

  clienteId String
  cliente   Usuario @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  refeicoes Refeicao[]
}

model Refeicao {
  id              String       @id @default(cuid())
  tipo            TipoRefeicao
  horarioSugerido String?

  dietaId String
  dieta   Dieta @relation(fields: [dietaId], references: [id], onDelete: Cascade)

  alimentos Alimento[]
  checks    CheckRefeicao[]
}

model Alimento {
  id         String  @id @default(cuid())
  nome       String
  quantidade String
  observacao String?

  refeicaoId String
  refeicao   Refeicao @relation(fields: [refeicaoId], references: [id], onDelete: Cascade)

  receitaId String?
  receita   Receita? @relation(fields: [receitaId], references: [id])
}

model Receita {
  id           String   @id @default(cuid())
  titulo       String
  ingredientes String[]
  modoPreparo  String[]
  tempoPreparo String?
  videoUrl     String?

  alimentos Alimento[]
}

model CheckRefeicao {
  id        String   @id @default(cuid())
  data      String   // YYYY-MM-DD
  realizada Boolean  @default(false)

  clienteId  String
  cliente    Usuario @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  refeicaoId String
  refeicao   Refeicao @relation(fields: [refeicaoId], references: [id], onDelete: Cascade)

  @@unique([clienteId, refeicaoId, data])
}

model Feedback {
  id       String   @id @default(cuid())
  data     String
  texto    String
  criadoEm DateTime @default(now())

  clienteId String
  cliente   Usuario @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

model RegistroProgresso {
  id      String   @id @default(cuid())
  data    String
  peso    Float?
  aguaMl  Int?
  criadoEm DateTime @default(now())

  clienteId String
  cliente   Usuario @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, data])
}

model Post {
  id         String   @id @default(cuid())
  titulo     String
  slug       String   @unique
  resumo     String
  conteudo   String
  imagemUrl  String?
  publicado  Boolean  @default(false)
  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

enum StatusAgendamento {
  PENDENTE
  CONFIRMADO
  CANCELADO
  REALIZADO
}

model Agendamento {
  id        String             @id @default(cuid())
  tipo      String
  data      String
  horario   String
  nome      String
  email     String
  telefone  String
  mensagem  String?
  status    StatusAgendamento  @default(PENDENTE)
  criadoEm  DateTime           @default(now())
}

model ConfigSite {
  id         String  @id @default("config")
  fotoSobre  String?
  fotoCapa   String?
  bio1       String?
  bio2       String?
  crn        String?
  especialidades String[]
  telefone   String?
  endereco   String?
  instagram  String?
  whatsapp   String?
}

model Servico {
  id        String  @id @default(cuid())
  titulo    String
  descricao String
  icone     String?
  imagemUrl String?
  ordem     Int     @default(0)
  ativo     Boolean @default(true)
}

model Plano {
  id        String   @id @default(cuid())
  nome      String
  preco     String
  periodo   String
  destaque  Boolean  @default(false)
  itens     String[]
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
}

model Avaliacao {
  id        String   @id @default(cuid())
  nota      Int      @default(5)
  texto     String
  aprovada  Boolean  @default(false)
  criadoEm  DateTime @default(now())

  clienteId String
  cliente   Usuario @relation(fields: [clienteId], references: [id], onDelete: Cascade)
}

model PerfilFoto {
  id     String @id @default(cuid())
  foto   String
  userId String @unique
}

model RegistroHabito {
  id                String   @id @default(cuid())
  data              String   // YYYY-MM-DD
  aderenciaDieta    Int      @default(0) // 0-10
  variedadeAlimentar Int     @default(0) // 0-10
  aceitacaoNovos    Int      @default(0) // 0-10
  hidratacao        Int      @default(0) // 0-10
  comportamentoMesa Int      @default(0) // 0-10

  // Aceitação grupos alimentares diários: true=aceitou, false=não aceitou, null=não informou
  acFrutas         Boolean?
  acVerduras       Boolean?
  acLegumes        Boolean?
  acProteinas      Boolean?
  acCereais        Boolean?
  acAgua           Boolean?

  // Hábitos inadequados diários: true=cometeu, false=não cometeu, null=não informou
  refrigerante     Boolean?
  doces            Boolean?
  fastFood         Boolean?
  ultraprocessados Boolean?
  beliscos         Boolean?

  observacao        String?
  criadoEm          DateTime @default(now())

  clienteId String
  cliente   Usuario @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([clienteId, data])
}

enum TipoEntradaDiario {
  NOTA
  MEDIDA
  AVALIACAO_NUTRICIONAL
  CONSULTA
}

enum TipoPergunta {
  TEXTO
  CHECKBOX
}

model Formulario {
  id        String   @id @default(cuid())
  titulo    String
  perguntas Json     // [{pergunta, tipo, opcoes?}]
  criadoEm  DateTime @default(now())

  clienteId String
  cliente   Usuario @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  respostas RespostaFormulario[]

  @@index([clienteId])
}

model RespostaFormulario {
  id           String   @id @default(cuid())
  respostas    Json     // [{pergunta, resposta}]
  respondidoEm DateTime @default(now())

  formularioId String
  formulario   Formulario @relation(fields: [formularioId], references: [id], onDelete: Cascade)
}

model EntradaDiario {
  id        String   @id @default(cuid())
  data      String   // YYYY-MM-DD
  tipo      TipoEntradaDiario
  titulo    String?
  texto     String?

  // Medidas clínicas (opcionais)
  peso          Float?
  pressaoSist   Int?    // sistólica
  pressaoDiast  Int?    // diastólica
  glicemia      Float?
  temperatura   Float?
  circAbdominal Float?
  circBraco     Float?
  circQuadril   Float?

  // Link opcional para avaliação nutricional
  avaliacaoNutricionalId String?

  criadoEm  DateTime @default(now())

  clienteId String
  cliente   Usuario @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId, data])
}

model AvaliacaoNutricional {
  id        String   @id @default(cuid())
  data      String   // YYYY-MM-DD
  tipo      String   // INICIAL ou ACOMPANHAMENTO

  // Aceitação de grupos alimentares (0-10)
  frutas        Int @default(0)
  verduras      Int @default(0)
  legumes       Int @default(0)
  proteinas     Int @default(0)
  cereais       Int @default(0)
  agua          Int @default(0)

  // Hábitos inadequados - frequência semanal (0-7)
  refrigerantes    Int @default(0)
  doces            Int @default(0)
  fastFood         Int @default(0)
  ultraprocessados Int @default(0)
  beliscos         Int @default(0)

  observacao String?
  criadoEm   DateTime @default(now())

  clienteId String
  cliente   Usuario @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId, data])
}
